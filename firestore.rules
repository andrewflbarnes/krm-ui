rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /env/{env} {
      function isValidEnv(env) {
        return env in ['dev', 'stage', 'prod'];
      }

      function isUploadOwner() {
        return request.auth.uid == request.resource.data.owner
      }

      function isResourceOwner() {
        return request.auth.uid == resource.data.owner
      }

      function isAuthenticated() {
        return request.auth != null;
      }

      allow read: if isValidEnv(env);

      match /users/{id} {
        allow read: if isValidEnv(env);
        allow create: if isValidEnv(env)
                      && isAuthenticated()
                      && request.auth.uid == id;
        allow update: if isValidEnv(env)
                      && isAuthenticated()
                      && request.auth.uid == id;
        allow delete: if false;
      }

      match /rounds/{id} {
        allow read: if isValidEnv(env);
        allow create: if isValidEnv(env)
                      && isAuthenticated()
                      && isUploadOwner();
        allow update: if isValidEnv(env)
                      && isAuthenticated()
                      && isUploadOwner()
                      && isResourceOwner();
        allow delete: if false;
      }
    }
  }
}
